# Your own files stay out of git (bundled samples live in app/examples/)
resumes/*
!resumes/.gitkeep
jobs/*
!jobs/.gitkeep
# Shortcut the launcher creates on first run (carries the app icon)
Resume Matcher.lnk
# Generated reports
results/
# Created by the launchers on first run; settings.json may hold an API key
app/.venv/
app/settings.json
app/setup.log
__pycache__/
*.pyc
.pytest_cache/
