<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ResumeMatcher.App.App"
             RequestedThemeVariant="Default">
  <!-- "Default" follows the Windows app mode (Settings > Personalization > Colors). -->

  <Application.Resources>
    <!-- The palette is defined here rather than borrowed from the theme's internal
         keys, so every surface is guaranteed to resolve in both variants. -->
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#E1E1E1" />
          <SolidColorBrush x:Key="ZoneBrush" Color="#FAFAFA" />
          <SolidColorBrush x:Key="ZoneHoverBrush" Color="#E6F0FB" />
          <SolidColorBrush x:Key="ZoneBorderBrush" Color="#C7C7C7" />
          <SolidColorBrush x:Key="MutedBrush" Color="#5D5D5D" />
          <SolidColorBrush x:Key="LogBrush" Color="#F6F8FA" />
          <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="CardBrush" Color="#2B2B2B" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#3D3D3D" />
          <SolidColorBrush x:Key="ZoneBrush" Color="#333333" />
          <SolidColorBrush x:Key="ZoneHoverBrush" Color="#1E3A5F" />
          <SolidColorBrush x:Key="ZoneBorderBrush" Color="#4D4D4D" />
          <SolidColorBrush x:Key="MutedBrush" Color="#A0A0A0" />
          <SolidColorBrush x:Key="LogBrush" Color="#1E1E1E" />
          <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />
          <SolidColorBrush x:Key="WarningBrush" Color="#FCE100" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style Selector="SelectableTextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
  </Application.Styles>
</Application>
